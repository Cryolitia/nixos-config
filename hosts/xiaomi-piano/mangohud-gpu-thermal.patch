+    static const std::regex gpu_names("gpu[0-9]*(_thermal)?");
+    static const std::regex hotspot_names("gpuss[0-9]*(_[0-9]+)*(_thermal)?");
+    const fs::path local_hwmon = fs::path("/sys/class/drm") / drm_node / "device/hwmon";
+    gpu_temperatures.discover(gpu_names, local_hwmon, {}, "temp1_input");
+    if (gpu_temperatures.empty())
+        gpu_temperatures.discover(gpu_names, "/sys/class/hwmon", "/sys/class/thermal", "temp1_input");
+    gpu_hotspots.discover(hotspot_names);
     memory_temp_file = open_thermal_zone("ddr-thermal");
     core_clock_file = open_core_clock();
 }
 
