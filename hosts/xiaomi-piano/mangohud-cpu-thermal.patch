+++ b/src/thermal_sensors.h
@@ -0,0 +1,82 @@
+#pragma once
+
+#include <algorithm>
+#include <filesystem>
+#include <fstream>
+#include <optional>
+#include <regex>
+#include <set>
+#include <string>
+
+// Read standard hwmon/thermal temperature inputs in millidegrees Celsius.
+// Selection and aggregation policy belong to the consumer, not the DT names.
+class ThermalSensors {
+    std::set<std::filesystem::path> inputs;
+
+    static bool matches(std::string name, const std::regex& names) {
+        std::replace(name.begin(), name.end(), '-', '_');
+        return std::regex_match(name, names);
+    }
+
+    template<typename Visitor>
+    static void visit(const std::filesystem::path& root, Visitor visitor) {
+        if (root.empty())
+            return;
+        std::error_code error;
+        for (std::filesystem::directory_iterator it(root, error), end;
+             !error && it != end; it.increment(error))
+            visitor(it->path());
+    }
+
+public:
+    bool empty() const { return inputs.empty(); }
+
+    void discover(const std::regex& names,
+                  const std::filesystem::path& hwmon = "/sys/class/hwmon",
+                  const std::filesystem::path& thermal = "/sys/class/thermal",
+                  const std::string& hwmon_input = "temp[0-9]+_input") {
+        const std::regex input_name(hwmon_input);
+        visit(hwmon, [&](const auto& directory) {
+            std::ifstream file(directory / "name");
+            std::string name;
+            if (!std::getline(file, name) || !matches(name, names))
+                return;
+            visit(directory, [&](const auto& input) {
+                if (std::regex_match(input.filename().string(), input_name))
+                    inputs.insert(input);
+            });
+        });
+        visit(thermal, [&](const auto& directory) {
+            if (directory.filename().string().find("thermal_zone") != 0)
+                return;
+            std::ifstream file(directory / "type");
+            std::string type;
+            if (std::getline(file, type) && matches(type, names))
+                inputs.insert(directory / "temp");
+        });
+    }
+
+    std::optional<int> maximum() const {
+        std::optional<int> result;
+        for (const auto& input : inputs) {
+            // Reopen so transient errors, sensor removal/recreation and stdio
+            // buffers cannot keep an old value alive. Zero and negatives are valid.
+            std::ifstream file(input);
+            int value;
+            std::string trailing;
+            if (!(file >> value) || (file >> trailing) || file.bad())
+                continue;
+            const auto filename = input.filename().string();
+            if (filename.ends_with("_input")) {
+                auto fault = input;
+                fault.replace_filename(filename.substr(0, filename.size() - 6) + "_fault");
+                std::ifstream fault_file(fault);
+                int failed = 0;
+                if ((fault_file >> failed) && failed)
+                    continue;
+            }
+            result = result ? std::max(*result, value) : value;
+        }
+        return result;
+    }
+};
